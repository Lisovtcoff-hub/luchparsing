# Web panel authentication
PANEL_USER=admin
PANEL_PASSWORD=replace_with_a_long_random_password

# Dellin
DELLIN_APPKEY=replace_with_dellin_app_key
DELLIN_API_TERMINALS=https://api.dellin.ru/v1/public/request_terminals.json
DELLIN_API_CALC=https://api.dellin.ru/v2/calculator.json
DELLIN_CONNECT_TIMEOUT=10
DELLIN_READ_TIMEOUT=30
DELLIN_MAX_ATTEMPTS=5
DELLIN_BACKOFF_BASE=0.4
DELLIN_BACKOFF_MAX=6
DELLIN_PRODUCE_DATE_MAX_SHIFT_DAYS=7

# Energiya
ENERGIYA_DEV_TOKEN=replace_with_energiya_dev_token
ENERGIYA_TOKEN=
ENERGIYA_BASE_URL=https://mainapi.nrg-tk.ru/
ENERGIYA_CITIES_TTL_S=86400
ENERGIYA_CONNECT_TIMEOUT_S=25
ENERGIYA_READ_TIMEOUT_S=60
ENERGIYA_CITIES_CACHE_PATH=/app/exports/energiya_cities.json
ENERGIYA_COOLDOWN_AFTER_ERRORS=3
ENERGIYA_COOLDOWN_S=90

# TK KIT
TKKIT_TOKEN=replace_with_tkkit_token
TKKIT_BASE_URL=https://capi.tk-kit.com
TKKIT_BLOCK_PRIVILEGED_PICKUP=1
TKKIT_BLOCK_OUT_OF_CITY=0
TKKIT_BANNED_TTL_S=1800

# Vozovoz
VOZOVOZ_TOKEN=replace_with_vozovoz_token
VOZOVOZ_BASE_URL=https://vozovoz.org/api/

# Orchestrator and logging
ORCH_WORKERS=12
ORCH_GLOBAL_LIMIT=12
HTTP_READ_TIMEOUT=60
LOG_MANUAL_ONLY=0
LOG_LEVEL=INFO
